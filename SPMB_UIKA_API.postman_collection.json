{
  "info": {
    "_postman_id": "uika-spmb-api-collection-2026",
    "name": "SIM SPMB UIKA Bogor - API Collection",
    "description": "Koleksi Endpoint API Lengkap Backend SIM Seleksi Penerimaan Mahasiswa Baru (SPMB) Universitas Ibn Khaldun Bogor.\nMendukung seluruh modul Camaba, Admin Dashboard, Pendaftar, One Day Service (ODS), Kelulusan, Referensi, Laporan UKT, dan Fitur Login As.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "camaba_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autentikasi (Auth)",
      "item": [
        {
          "name": "Login Admin SPMB (Auto-Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('admin_token', jsonData.data.token);",
                  "    console.log('✔ Token Admin berhasil disimpan ke variabel: ' + jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@uika-bogor.ac.id\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login sebagai Admin SPMB. Skrip pengujian otomatis menyimpan token ke variabel {{admin_token}}."
          }
        },
        {
          "name": "Login Camaba via ID Pendaftar + PIN (Auto-Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('camaba_token', jsonData.data.token);",
                  "    console.log('✔ Token Camaba berhasil disimpan ke variabel: ' + jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"4102541051\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login pendaftar menggunakan ID Pendaftar (contoh akun Rosiana: 4102541051) dan PIN/Password: 123456."
          }
        },
        {
          "name": "Login Camaba via Email + Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rosiana@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Registrasi Akun Camaba Baru",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Calon Mahasiswa Baru 2026\",\n  \"email\": \"camaba.baru.2026@gmail.com\",\n  \"password\": \"password123\"\n}"
